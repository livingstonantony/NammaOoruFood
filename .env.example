# Copy to .env (never commit .env). All values below are placeholders.
APP_ENV=production
JWT_SECRET=replace-with-at-least-32-random-characters
DB_URL=jdbc:mysql://db-host:3306/nammaoorufood?useSSL=true&serverTimezone=UTC
DB_USER=replace-me
DB_PASSWORD=replace-me
# Creates the first admin once (skipped if the username exists). Remove after first start.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional
PORT=8080
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
LOGIN_RATE_LIMIT_PER_MINUTE=10
DB_POOL_SIZE=10
# Swagger UI is off in production unless set to true
ENABLE_API_DOCS=false
