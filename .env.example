# Copy to .env (never commit .env). All values below are placeholders.
APP_ENV=production
JWT_SECRET=replace-with-at-least-32-random-characters
DB_URL=jdbc:mysql://db-host:3306/nammaoorufood?useSSL=true&serverTimezone=UTC
DB_USER=replace-me
DB_PASSWORD=replace-me
# ImageKit server credentials (never put the private key in a client).
IMAGEKIT_PUBLIC_KEY=public_replace_me
IMAGEKIT_PRIVATE_KEY=private_replace_me
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/replace_me
# Creates the first admin once (skipped if the username exists). Remove after first start.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional
PORT=8080
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
LOGIN_RATE_LIMIT_PER_MINUTE=10
DB_POOL_SIZE=10
# Optional Telegram Mini App sign-in and bot. Keep the bot token server-side only.
TELEGRAM_BOT_TOKEN=
# Public HTTPS origin serving the Mini App. Adds an Open Mini App button to /start and /help.
TELEGRAM_MINI_APP_URL=https://miniapp.example.com
# Exactly one server instance should poll Telegram. Defaults to true except in tests.
TELEGRAM_BOT_POLLING_ENABLED=true
# Production browser origins, comma-separated (include the Mini App origin).
CORS_ALLOWED_ORIGINS=https://miniapp.example.com
# Swagger UI is off in production unless set to true
ENABLE_API_DOCS=false
